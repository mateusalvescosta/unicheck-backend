# Modelo do .env. Copie para ".env" na raiz do projeto e preencha.
# O .env e ignorado pelo Git; este modelo e versionado, entao nunca coloque valores reais aqui.
#
# Formato: CHAVE=valor, sem aspas e sem espacos ao redor do "=". Linhas com # sao comentarios.
# Variaveis de ambiente reais do sistema tem precedencia sobre o .env.

# --- E-mail pelo Resend (SMTP) ---
# Sem estas linhas, a aplicacao usa o Mailpit local (localhost:1025).
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=PREENCHA_COM_A_API_KEY_DO_RESEND
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
# Sem dominio verificado no Resend, use onboarding@resend.dev; ele so entrega para o e-mail da sua conta.
MAIL_REMETENTE=onboarding@resend.dev

# --- Link enviado no e-mail de recuperacao ---
RECUPERACAO_SENHA_URL_FRONTEND=http://localhost:3000/redefinir-senha

# --- Opcionais: so se quiser sobrescrever os valores do application.properties ---
# DB_URL=jdbc:postgresql://localhost:5432/unicheck_db
# DB_USERNAME=
# DB_PASSWORD=
# JWT_SECRET=
# JWT_ISSUER=https://unicheck.local
